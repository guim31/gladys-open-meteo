{
  "manifest_version": 1,
  "type": "weather",
  "name": "Open-Meteo",
  "description": {
    "en": "Free worldwide forecasts from the national weather models, no account or API key needed.",
    "fr": "Prévisions mondiales gratuites des modèles météo nationaux, sans compte ni clé d'API."
  },
  "version": "1.0.1",
  "docker_image": "ghcr.io/guim31/gladys-open-meteo:1.0.1",
  "gladys_version": ">=5.1.0",
  "cover_image": "https://raw.githubusercontent.com/guim31/gladys-open-meteo/main/cover.png",
  "categories": ["environment"],
  "transports": ["cloud"],
  "location": true,
  "config_schema": [
    {
      "key": "intro",
      "type": "section",
      "label": { "en": "Nothing to sign up for", "fr": "Aucune inscription" },
      "description": {
        "en": "Open-Meteo is free for non-commercial use and needs no API key. The integration refreshes the weather of every house that has a location in Gladys. Weather data by Open-Meteo.com (CC BY 4.0); this integration is not affiliated with Open-Meteo.",
        "fr": "Open-Meteo est gratuit pour un usage non commercial et ne demande aucune clé d'API. L'intégration met à jour la météo de chaque maison qui a une position dans Gladys. Weather data by Open-Meteo.com (CC BY 4.0) ; cette intégration n'est pas affiliée à Open-Meteo."
      },
      "links": [
        {
          "url": "https://open-meteo.com/",
          "label": { "en": "About Open-Meteo", "fr": "À propos d'Open-Meteo" }
        },
        {
          "url": "https://open-meteo.com/en/terms",
          "label": { "en": "Terms of use", "fr": "Conditions d'utilisation" }
        }
      ]
    },
    {
      "key": "refresh_interval",
      "type": "select",
      "label": { "en": "Refresh interval", "fr": "Fréquence de mise à jour" },
      "description": {
        "en": "Each refresh costs one call per house. Every 15 minutes keeps the rain forecast of the next hour up to date.",
        "fr": "Chaque mise à jour coûte un appel par maison. Toutes les 15 minutes garde à jour la prévision de pluie de l'heure à venir."
      },
      "required": false,
      "default": "15",
      "options": [
        {
          "value": "15",
          "label": {
            "en": "Every 15 minutes (recommended)",
            "fr": "Toutes les 15 minutes (recommandé)"
          }
        },
        { "value": "30", "label": { "en": "Every 30 minutes", "fr": "Toutes les 30 minutes" } },
        { "value": "60", "label": { "en": "Every hour", "fr": "Toutes les heures" } }
      ]
    },
    {
      "key": "model",
      "type": "select",
      "label": { "en": "Weather model", "fr": "Modèle météo" },
      "description": {
        "en": "Automatic combines the best models for your location. Pick a model only to follow a given weather service.",
        "fr": "Automatique combine les meilleurs modèles pour votre position. Choisissez un modèle seulement pour suivre un service météo précis."
      },
      "required": false,
      "default": "best_match",
      "options": [
        {
          "value": "best_match",
          "label": { "en": "Automatic (recommended)", "fr": "Automatique (recommandé)" }
        },
        {
          "value": "meteofrance_seamless",
          "label": {
            "en": "Météo-France (AROME, ARPEGE)",
            "fr": "Météo-France (AROME, ARPEGE)"
          }
        },
        {
          "value": "icon_seamless",
          "label": { "en": "DWD ICON (Germany)", "fr": "DWD ICON (Allemagne)" }
        },
        {
          "value": "gfs_seamless",
          "label": { "en": "NOAA GFS and HRRR (USA)", "fr": "NOAA GFS et HRRR (États-Unis)" }
        },
        {
          "value": "ecmwf_ifs025",
          "label": { "en": "ECMWF IFS (Europe)", "fr": "ECMWF IFS (Europe)" }
        },
        {
          "value": "ukmo_seamless",
          "label": { "en": "UK Met Office", "fr": "Met Office (Royaume-Uni)" }
        },
        {
          "value": "gem_seamless",
          "label": { "en": "Environment Canada GEM", "fr": "Environnement Canada GEM" }
        },
        {
          "value": "metno_seamless",
          "label": { "en": "MET Norway (Nordic)", "fr": "MET Norway (pays nordiques)" }
        },
        {
          "value": "meteoswiss_icon_seamless",
          "label": { "en": "MeteoSwiss ICON", "fr": "MétéoSuisse ICON" }
        }
      ]
    },
    {
      "key": "language",
      "type": "select",
      "label": { "en": "Language of the scene texts", "fr": "Langue des textes de scène" },
      "description": {
        "en": "Language of the sentences the integration puts in scene variables. Automatic follows the language of your Gladys.",
        "fr": "Langue des phrases que l'intégration met dans les variables de scène. Automatique suit la langue de votre Gladys."
      },
      "required": false,
      "default": "auto",
      "options": [
        { "value": "auto", "label": { "en": "Automatic", "fr": "Automatique" } },
        { "value": "en", "label": { "en": "English", "fr": "Anglais" } },
        { "value": "fr", "label": { "en": "French", "fr": "Français" } }
      ]
    }
  ],
  "actions": [
    {
      "key": "test_connection",
      "label": { "en": "Test Open-Meteo", "fr": "Tester Open-Meteo" },
      "description": {
        "en": "Fetches the weather of your first house now and shows its current temperature.",
        "fr": "Récupère la météo de votre première maison maintenant et affiche sa température actuelle."
      },
      "timeout_seconds": 20
    }
  ],
  "scene_triggers": [
    {
      "key": "precipitation_expected",
      "label": {
        "en": "Rain or snow expected within the hour",
        "fr": "Pluie ou neige attendue dans l'heure"
      },
      "description": {
        "en": "The 15-minute forecast now shows precipitation within the hour, where the previous refresh showed none.",
        "fr": "La prévision au quart d'heure annonce des précipitations dans l'heure, là où la mise à jour précédente n'en annonçait pas."
      },
      "fields": [
        {
          "key": "house",
          "type": "string",
          "label": { "en": "House", "fr": "Maison" },
          "description": {
            "en": "Name of the house, exactly as shown in Gladys. Leave empty for every house.",
            "fr": "Nom de la maison, exactement comme dans Gladys. Laissez vide pour toutes les maisons."
          },
          "required": false
        },
        {
          "key": "precipitation_type",
          "type": "multi_select",
          "label": { "en": "Precipitation", "fr": "Précipitations" },
          "description": {
            "en": "Leave empty for any precipitation.",
            "fr": "Laissez vide pour toutes les précipitations."
          },
          "required": false,
          "options": [
            { "value": "rain", "label": { "en": "Rain", "fr": "Pluie" } },
            { "value": "snow", "label": { "en": "Snow", "fr": "Neige" } },
            {
              "value": "freezing_rain",
              "label": { "en": "Freezing rain", "fr": "Pluie verglaçante" }
            }
          ]
        },
        {
          "key": "intensity",
          "type": "multi_select",
          "label": { "en": "Intensity", "fr": "Intensité" },
          "description": {
            "en": "Strongest intensity expected. Leave empty for any intensity.",
            "fr": "Intensité la plus forte attendue. Laissez vide pour toute intensité."
          },
          "required": false,
          "options": [
            { "value": "light", "label": { "en": "Light", "fr": "Faible" } },
            { "value": "moderate", "label": { "en": "Moderate", "fr": "Modérée" } },
            { "value": "heavy", "label": { "en": "Heavy", "fr": "Forte" } }
          ]
        }
      ],
      "variables": [
        { "key": "house", "type": "string", "label": { "en": "House", "fr": "Maison" } },
        {
          "key": "precipitation_type",
          "type": "string",
          "label": {
            "en": "Precipitation (rain, snow, freezing_rain)",
            "fr": "Précipitations (rain, snow, freezing_rain)"
          }
        },
        {
          "key": "intensity",
          "type": "string",
          "label": {
            "en": "Intensity (light, moderate, heavy)",
            "fr": "Intensité (light, moderate, heavy)"
          }
        },
        {
          "key": "minutes_until",
          "type": "number",
          "label": { "en": "Minutes until it starts", "fr": "Minutes avant le début" }
        },
        {
          "key": "probability",
          "type": "number",
          "label": { "en": "Probability (%)", "fr": "Probabilité (%)" }
        },
        {
          "key": "summary",
          "type": "string",
          "label": { "en": "Summary", "fr": "Résumé" },
          "description": {
            "en": "A sentence ready to put in a message.",
            "fr": "Une phrase prête à mettre dans un message."
          }
        }
      ]
    }
  ],
  "scene_actions": [
    {
      "key": "get_precipitation_next_hour",
      "label": {
        "en": "Get the precipitation of the next hour",
        "fr": "Obtenir les précipitations de l'heure à venir"
      },
      "description": {
        "en": "Reads the 15-minute forecast of a house, to act if rain or snow is coming.",
        "fr": "Lit la prévision au quart d'heure d'une maison, pour agir si de la pluie ou de la neige arrive."
      },
      "timeout_seconds": 20,
      "fields": [
        {
          "key": "house",
          "type": "string",
          "label": { "en": "House", "fr": "Maison" },
          "description": {
            "en": "Name of the house, exactly as shown in Gladys. Leave empty for your first house.",
            "fr": "Nom de la maison, exactement comme dans Gladys. Laissez vide pour votre première maison."
          },
          "required": false
        }
      ],
      "outputs": [
        {
          "key": "available",
          "type": "boolean",
          "label": { "en": "Forecast available", "fr": "Prévision disponible" }
        },
        {
          "key": "precipitation_expected",
          "type": "boolean",
          "label": { "en": "Precipitation expected", "fr": "Précipitations attendues" }
        },
        {
          "key": "minutes_until",
          "type": "number",
          "label": { "en": "Minutes until it starts", "fr": "Minutes avant le début" }
        },
        {
          "key": "precipitation_type",
          "type": "string",
          "label": {
            "en": "Precipitation (rain, snow, freezing_rain)",
            "fr": "Précipitations (rain, snow, freezing_rain)"
          }
        },
        {
          "key": "intensity",
          "type": "string",
          "label": {
            "en": "Intensity (light, moderate, heavy)",
            "fr": "Intensité (light, moderate, heavy)"
          }
        },
        {
          "key": "probability",
          "type": "number",
          "label": { "en": "Probability (%)", "fr": "Probabilité (%)" }
        },
        {
          "key": "summary",
          "type": "string",
          "label": { "en": "Summary", "fr": "Résumé" }
        }
      ]
    }
  ],
  "widgets": [
    {
      "key": "precipitation_next_hours",
      "label": { "en": "Precipitation, next 2 hours", "fr": "Pluie des 2 prochaines heures" },
      "description": {
        "en": "Quarter-hour rain and snow chart for the next two hours.",
        "fr": "Graphique au quart d'heure de la pluie et de la neige des deux prochaines heures."
      },
      "icon": "cloud-rain",
      "settings": [
        {
          "key": "house",
          "type": "string",
          "label": { "en": "House", "fr": "Maison" },
          "description": {
            "en": "Name of the house, exactly as shown in Gladys. Leave empty for your first house.",
            "fr": "Nom de la maison, exactement comme dans Gladys. Laissez vide pour votre première maison."
          },
          "required": false
        }
      ]
    }
  ]
}
